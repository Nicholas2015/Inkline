root = true

[*.{cpp,h,cmake,qss,yml,md,py,ps1}]
charset = utf-8
insert_final_newline = true

[{src,tests}/**.{cpp,h}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,**/CMakeLists.txt,*.cmake,.github/workflows/*.yml}]
indent_style = space
indent_size = 2

[{tests/*.py,packaging/*.ps1}]
indent_style = space
indent_size = 4

[third_party/{libyaml,tomlplusplus}/**]
charset = unset
insert_final_newline = unset
